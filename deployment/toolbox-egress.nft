# Load using nft -f after creating the toolbox account. Persistent rules are required.
# The table only restricts outbound traffic from this service UID.
table inet toolbox_egress {
    set blocked4 {
        type ipv4_addr
        flags interval
        elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8,
                     169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.0.2.0/24,
                     192.168.0.0/16, 198.18.0.0/15, 198.51.100.0/24,
                     203.0.113.0/24, 224.0.0.0/3 }
    }
    chain output {
        type filter hook output priority 0; policy accept;
        # Replies to inbound proxy requests must remain possible. Do not exempt
        # established outbound connections: destination rules apply to every packet.
        meta skuid "toolbox" ct direction reply accept
        meta skuid "toolbox" ip daddr @blocked4 counter reject
        # Only global IPv6 unicast; deny IPv4 mapping, NAT64, 6to4 and Teredo
        # so translation cannot bypass the IPv4 destination policy.
        meta skuid "toolbox" ip6 daddr != 2000::/3 counter reject
        meta skuid "toolbox" ip6 daddr { 2001::/32, 2001:db8::/32, 2002::/16 } counter reject
        meta skuid "toolbox" tcp dport { 80, 443 } accept
        # Configure a public resolver in /etc/resolv.conf, not a loopback stub.
        meta skuid "toolbox" udp dport 53 accept
        meta skuid "toolbox" tcp dport 53 accept
        meta skuid "toolbox" counter reject
    }
}
