[Unit]
Description=Tool Box media service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=toolbox
Group=toolbox
WorkingDirectory=/opt/toolbox
ExecStart=/opt/toolbox/admersite
Environment=ADDRESS=127.0.0.1
Environment=PORT=8080
Environment=HSTS_MAX_AGE_SECONDS=31536000
Environment=TRUSTED_PROXY_IPS=127.0.0.1,::1
Environment=HOME=/var/lib/toolbox
Environment=TMPDIR=/opt/toolbox/storage/tmp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/toolbox/storage /var/lib/toolbox
StateDirectory=toolbox
UMask=0077
TasksMax=128
MemoryMax=1536M
MemorySwapMax=0
CPUQuota=200%
LimitNOFILE=1024
KillMode=control-group
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
