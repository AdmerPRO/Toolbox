PORT=8080
ADDRESS=127.0.0.1
# Public origin used by canonical links, sitemap.xml, and robots.txt
SITE_URL=https://tools.admerpro.pl

# Per-client API limits in independent 60-second windows
RATE_LIMIT_API_PER_MINUTE=60
RATE_LIMIT_JOBS_PER_MINUTE=10
MAX_CONCURRENT_JOBS_PER_CLIENT=1
# Exact proxy socket IPs allowed to provide CF-Connecting-IP / X-Forwarded-For; empty means direct clients
TRUSTED_PROXY_IPS=

# Storage capacity includes active files, staging, legacy files, and ZIP archives.
# Jobs reserve additional space before starting; one server process per storage root.
MAX_STORAGE_BYTES=32212254720
MIN_FREE_DISK_BYTES=5368709120
UPLOAD_TIMEOUT_SECONDS=300
